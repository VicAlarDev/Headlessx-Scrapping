# ============================================
# HeadlessX v1.3.0 - Environment Configuration
# ============================================
# Copy this file to .env and fill in your values

# ============================================
# SERVER CONFIGURATION
# ============================================
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# ============================================
# AUTHENTICATION TOKENS (REQUIRED)
# ============================================
# Generate with: openssl rand -hex 32
AUTH_TOKEN=your_secure_auth_token_here
ADMIN_TOKEN=your_secure_admin_token_here
PROFILE_MANAGEMENT_TOKEN=your_profile_management_token_here

# ============================================
# GEMINI AI CONFIGURATION (REQUIRED FOR AI EXTRACTION)
# ============================================
# Get your API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Model to use (optional, defaults to gemini-2.0-flash)
# Options: gemini-2.0-flash, gemini-1.5-pro, gemini-1.5-flash
GEMINI_MODEL=gemini-2.0-flash

# ============================================
# BROWSER CONFIGURATION
# ============================================
BROWSER_HEADLESS=true
BROWSER_TIMEOUT=90000
BROWSER_EXTRA_WAIT=10000
BROWSER_MAX_CONCURRENCY=3
BROWSER_NAVIGATION_TIMEOUT=60000
BROWSER_ANTIBOT_RETRY_DELAY=5000
BROWSER_POOL_SIZE=5
MAX_BROWSER_INSTANCES=10

# ============================================
# ANTI-DETECTION CONFIGURATION
# ============================================
# Stealth mode: basic, advanced, maximum
STEALTH_MODE=advanced
STEALTH_CONSISTENCY_CHECK=true
STEALTH_VALIDATION=true

# Fingerprint settings
FINGERPRINT_PROFILE=desktop-chrome
PROFILE_ROTATION_ENABLED=false

# Behavioral simulation
BEHAVIORAL_SIMULATION=true
MOUSE_MOVEMENT_NATURAL=true
KEYBOARD_DYNAMICS=true
SCROLL_BEHAVIOR=natural

# Advanced fingerprinting
WEBRTC_LEAK_PROTECTION=true
CANVAS_NOISE_LEVEL=medium
WEBGL_SPOOFING=true
AUDIO_FINGERPRINT_NOISE=true

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_PER_TOKEN=true

# ============================================
# API SETTINGS
# ============================================
API_BODY_LIMIT=50mb
API_MAX_BATCH_URLS=10
API_DEFAULT_PARTIAL_TIMEOUT=false

# ============================================
# SECURITY
# ============================================
CORS_ENABLED=true
ALLOWED_ORIGINS=*
HELMET_ENABLED=true

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=info
DEBUG=false
VERBOSE_LOGGING=false

# ============================================
# FEATURES
# ============================================
ENABLE_DETECTION_SUITE=true
ENABLE_ADMIN_ROUTES=false
REQUEST_ANALYZER_ENABLED=true
RATE_LIMITER_ENABLED=true

# ============================================
# PERFORMANCE
# ============================================
PERFORMANCE_MONITORING=true
MEMORY_OPTIMIZATION=normal
